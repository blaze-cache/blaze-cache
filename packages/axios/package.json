{
  "name": "@blaze-cache/axios",
  "version": "0.1.1",
  "description": "Cache HTTP responses in axios via a WebAssembly cache — TTLs, tags, Cache-Control support and IndexedDB persistence",
  "keywords": [
    "axios",
    "cache",
    "caching",
    "http",
    "adapter",
    "interceptor",
    "webassembly",
    "wasm",
    "ttl",
    "persistence"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaze-cache/blaze-cache.git",
    "directory": "packages/axios"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@blaze-cache/core": "workspace:*"
  },
  "peerDependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "axios": "^1.11.0",
    "typescript": "^5.9.3"
  }
}
