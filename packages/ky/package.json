{
  "name": "@blaze-cache/ky",
  "version": "0.2.5",
  "description": "Cache ky HTTP responses via a WebAssembly cache — TTLs, tags, Cache-Control support and an x-blaze-cache HIT/MISS marker",
  "keywords": [
    "ky",
    "fetch",
    "http",
    "request",
    "cache",
    "caching",
    "hooks",
    "cache-control",
    "webassembly",
    "wasm",
    "ttl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaze-cache/blaze-cache.git",
    "directory": "packages/ky"
  },
  "homepage": "https://blaze-cache.github.io/docs/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@blaze-cache/core": "workspace:*"
  },
  "peerDependencies": {
    "ky": "^1.14.0 || ^2.0.0"
  },
  "devDependencies": {
    "ky": "^1.14.3",
    "ky2": "npm:ky@^2.2.0",
    "typescript": "^5.9.3"
  }
}
