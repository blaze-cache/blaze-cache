{
  "name": "@blaze-cache/ofetch",
  "version": "0.4.0-beta.0",
  "description": "Cache ofetch ($fetch) responses via a WebAssembly cache — TTLs, tags, Cache-Control support and an x-blaze-cache HIT/MISS marker",
  "keywords": [
    "ofetch",
    "$fetch",
    "fetch",
    "http",
    "request",
    "cache",
    "caching",
    "hooks",
    "cache-control",
    "webassembly",
    "wasm",
    "ttl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaze-cache/blaze-cache.git",
    "directory": "packages/ofetch"
  },
  "homepage": "https://blaze-cache.github.io/docs/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm run build",
    "test:live": "pnpm run build && BLAZE_CACHE_LIVE=1 node --test test/live.test.mjs"
  },
  "dependencies": {
    "@blaze-cache/core": "workspace:*",
    "ufo": "^1.5.0"
  },
  "peerDependencies": {
    "ofetch": "^1.0.0"
  },
  "devDependencies": {
    "ofetch": "^1.5.1",
    "typescript": "^5.9.3"
  }
}
