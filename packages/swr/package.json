{
  "name": "@blaze-cache/swr",
  "version": "0.2.5",
  "description": "Persist SWR in WebAssembly — instant first paint after reload while stale-while-revalidate still works",
  "keywords": [
    "swr",
    "react",
    "cache",
    "persistence",
    "stale-while-revalidate",
    "webassembly",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaze-cache/blaze-cache.git",
    "directory": "packages/swr"
  },
  "homepage": "https://blaze-cache.github.io/docs/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@blaze-cache/core": "workspace:*"
  },
  "peerDependencies": {
    "swr": "^2.0.0"
  },
  "devDependencies": {
    "swr": "^2.5.1",
    "typescript": "^5.9.3"
  }
}
