{
  "name": "@blaze-cache/fetch",
  "version": "0.2.0-beta",
  "description": "Drop-in fetch() replacement backed by a WebAssembly cache — TTLs, Cache-Control, stale-while-revalidate and an x-blaze-cache HIT/MISS marker",
  "keywords": [
    "fetch",
    "http",
    "request",
    "cache",
    "caching",
    "stale-while-revalidate",
    "cache-control",
    "webassembly",
    "wasm",
    "ttl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaze-cache/blaze-cache.git",
    "directory": "packages/fetch"
  },
  "homepage": "https://blaze-cache.github.io/docs/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "test:live": "pnpm run build && BLAZE_CACHE_LIVE=1 node --test test/live.test.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@blaze-cache/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
