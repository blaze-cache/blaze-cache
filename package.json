{
  "name": "blaze-cache-monorepo",
  "private": true,
  "version": "0.3.0-beta.1",
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:wasm && pnpm -r --filter '!blaze-cache-example*' build",
    "build:wasm": "wasm-pack build crates/blaze-cache-wasm --target web --out-dir ../../packages/core/pkg && rm -f packages/core/pkg/.gitignore",
    "build:packages": "pnpm -r --filter '!blaze-cache-example*' build",
    "build:example": "pnpm build && pnpm --filter 'blaze-cache-example*' build",
    "dev:core": "pnpm build && pnpm --filter blaze-cache-example-core dev",
    "dev:axios": "pnpm build && pnpm --filter blaze-cache-example-axios dev",
    "dev:fetch": "pnpm build && pnpm --filter blaze-cache-example-fetch dev",
    "dev:ky": "pnpm build && pnpm --filter blaze-cache-example-ky dev",
    "dev:react-query": "pnpm build && pnpm --filter blaze-cache-example-react-query dev",
    "dev:swr": "pnpm build && pnpm --filter blaze-cache-example-swr dev",
    "typecheck": "pnpm -r typecheck",
    "test": "cargo test --workspace",
    "test:js": "pnpm build:wasm && pnpm -r test",
    "test:live": "pnpm build:wasm && pnpm -r test:live",
    "test:wasm": "wasm-pack test --node crates/blaze-cache-wasm",
    "bench": "pnpm build:wasm && pnpm --filter @blaze-cache/core build && pnpm --filter blaze-cache-bench bench",
    "publish": "pnpm build && pnpm -r publish --no-git-checks",
    "publish:beta": "pnpm build && pnpm -r publish --tag beta --no-git-checks",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && pnpm typecheck",
    "clean": "rm -rf packages/core/pkg packages/*/dist examples/*/dist target"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
