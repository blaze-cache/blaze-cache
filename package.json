{
  "name": "blaze-cache-monorepo",
  "private": true,
  "version": "0.2.0-beta",
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:wasm && pnpm -r --filter '!blaze-cache-example' build",
    "build:wasm": "wasm-pack build crates/blaze-cache-wasm --target web --out-dir ../../packages/core/pkg && rm -f packages/core/pkg/.gitignore",
    "build:packages": "pnpm -r --filter '!blaze-cache-example' build",
    "build:example": "pnpm build && pnpm --filter blaze-cache-example build",
    "dev": "pnpm build && pnpm --filter blaze-cache-example dev",
    "typecheck": "pnpm -r typecheck",
    "test": "cargo test --workspace",
    "test:js": "pnpm build:wasm && pnpm -r test",
    "test:live": "pnpm build:wasm && pnpm -r test:live",
    "test:wasm": "wasm-pack test --node crates/blaze-cache-wasm",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && pnpm typecheck",
    "clean": "rm -rf packages/core/pkg packages/*/dist examples/*/dist target"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
