{
  "name": "blaze-cache-bench",
  "private": true,
  "version": "0.1.0",
  "description": "Benchmarks @blaze-cache/core against Map, quick-lru, lru-cache and hand-rolled feature stacks, in Node and the browser",
  "type": "module",
  "scripts": {
    "bench": "node --expose-gc bench.mjs",
    "test": "(test -f ../../packages/core/dist/index.js || pnpm --filter @blaze-cache/core build) && node --test"
  },
  "dependencies": {
    "@blaze-cache/core": "workspace:*",
    "lru-cache": "^11.5.3",
    "quick-lru": "^8.0.0"
  }
}
